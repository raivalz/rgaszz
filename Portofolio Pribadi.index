<!doctype html>
<html lang="id" class="h-full">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Raivalla Yuri SE Pratiwi | Portfolio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/_sdk/element_sdk.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&amp;family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;display=swap" rel="stylesheet">
  <style>
    body {
      box-sizing: border-box;
    }
    
    html {
      scroll-behavior: smooth;
    }
    
    .font-serif-elegant {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
    
    .font-sans-modern {
      font-family: 'DM Sans', system-ui, sans-serif;
    }
    
    .gradient-moss {
      background: linear-gradient(135deg, #4a5d4a 0%, #6b7b6b 50%, #8b9b8b 100%);
    }
    
    .text-gradient {
      background: linear-gradient(135deg, #3d4d3d 0%, #5a6b5a 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .card-hover {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .card-hover:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 50px -12px rgba(74, 93, 74, 0.25);
    }
    
    .timeline-line {
      background: linear-gradient(180deg, #4a5d4a 0%, #d4c5b0 100%);
    }
    
    .nav-link {
      position: relative;
    }
    
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 2px;
      background: #4a5d4a;
      transition: width 0.3s ease;
    }
    
    .nav-link:hover::after {
      width: 100%;
    }
    
    .blob-shape {
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
      animation: blob-morph 8s ease-in-out infinite;
    }
    
    @keyframes blob-morph {
      0%, 100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
      50% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
    }
    
    .fade-in {
      animation: fadeIn 0.8s ease-out forwards;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .stagger-1 { animation-delay: 0.1s; }
    .stagger-2 { animation-delay: 0.2s; }
    .stagger-3 { animation-delay: 0.3s; }
    .stagger-4 { animation-delay: 0.4s; }
    
    .section-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, #d4c5b0, transparent);
    }
  </style>
  <style>@view-transition { navigation: auto; }</style>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
 </head>
 <body class="h-full font-sans-modern">
  <div id="app-wrapper" class="w-full h-full overflow-auto bg-gradient-to-br from-stone-50 via-amber-50/30 to-stone-100"><!-- Sticky Header -->
   <header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="backdrop-blur-md bg-stone-50/90 border-b border-stone-200/50">
     <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between"><a href="#beranda" class="font-serif-elegant text-2xl font-bold tracking-tight" id="logo-name" style="color: #4a5d4a;"> Raivalla Yuri, SH </a>
      <nav class="hidden md:flex items-center gap-8"><a href="#beranda" class="nav-link text-sm font-medium tracking-wide uppercase" style="color: #5a4a3a;">Beranda</a> <a href="#about" class="nav-link text-sm font-medium tracking-wide uppercase" style="color: #5a4a3a;">About</a> <a href="#portofolio" class="nav-link text-sm font-medium tracking-wide uppercase" style="color: #5a4a3a;">Portofolio</a> <a href="#contact" class="nav-link text-sm font-medium tracking-wide uppercase" style="color: #5a4a3a;">Contact</a>
      </nav><button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-stone-200/50 transition-colors" style="color: #4a5d4a;">
       <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
       </svg></button>
     </div>
    </div><!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden backdrop-blur-md bg-stone-50/95 border-b border-stone-200/50">
     <div class="px-6 py-4 space-y-4"><a href="#beranda" class="block text-sm font-medium tracking-wide uppercase" style="color: #5a4a3a;">Beranda</a> <a href="#about" class="block text-sm font-medium tracking-wide uppercase" style="color: #5a4a3a;">About</a> <a href="#portofolio" class="block text-sm font-medium tracking-wide uppercase" style="color: #5a4a3a;">Portofolio</a> <a href="#contact" class="block text-sm font-medium tracking-wide uppercase" style="color: #5a4a3a;">Contact</a>
     </div>
    </div>
   </header><!-- Hero Section -->
   <section id="beranda" class="min-h-screen pt-24 pb-16 px-6 flex items-center">
    <div class="max-w-7xl mx-auto w-full">
     <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center"><!-- Left: Text Content -->
      <div class="order-2 lg:order-1 space-y-8">
       <div class="space-y-4 fade-in stagger-1" style="opacity: 0;">
        <p class="text-sm font-semibold tracking-[0.3em] uppercase" style="color: #4a5d4a;">Welcome</p>
        <h1 id="hero-name" class="font-serif-elegant text-5xl md:text-6xl lg:text-7xl font-bold leading-tight" style="color: #3d4d3d;">Raivalla Yuri<br>
         SE Pratiwi, SH.,LL.M.,CLTS</h1>
        <p id="hero-tagline" class="text-lg md:text-xl font-medium tracking-wide" style="color: #8b7355;">Problem Solver • Translator • Debater</p>
       </div>
       <div class="fade-in stagger-2" style="opacity: 0;">
        <p id="hero-headline" class="font-serif-elegant text-2xl md:text-3xl italic leading-relaxed" style="color: #5a6b5a;">"Menggabungkan hukum, bahasa, dan logika untuk menciptakan solusi yang berdampak."</p>
       </div>
       <p id="hero-intro" class="text-base md:text-lg leading-relaxed fade-in stagger-3" style="opacity: 0; color: #6b5b4b;">Saya memiliki ketertarikan pada berbagai bidang yang membentuk pola pikir adaptif dan analitis. Melalui pengalaman di bidang hukum, bahasa asing, dan debat, saya mengembangkan komunikasi strategis serta kemampuan problem solving yang presisi dalam menghadapi tantangan yang kompleks.</p>
       <div class="flex flex-wrap gap-4 fade-in stagger-4" style="opacity: 0;"><a href="#portofolio" class="group inline-flex items-center gap-3 px-8 py-4 rounded-full font-semibold text-white transition-all duration-300 hover:shadow-xl hover:scale-105" style="background: linear-gradient(135deg, #4a5d4a 0%, #5a6b5a 100%);"> Lihat Portofolio 
         <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
         </svg></a> <a href="#contact" class="inline-flex items-center gap-3 px-8 py-4 rounded-full font-semibold border-2 transition-all duration-300 hover:shadow-lg" style="color: #4a5d4a; border-color: #4a5d4a; background: transparent;"> Hubungi Saya </a>
       </div>
      </div><!-- Right: Photo/Illustration -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
       <div class="relative"><!-- Decorative blob background -->
        <div class="absolute -inset-8 blob-shape opacity-20" style="background: linear-gradient(135deg, #4a5d4a, #d4c5b0);"></div><!-- Photo container -->
        <div class="relative w-72 h-72 md:w-96 md:h-96 rounded-3xl overflow-hidden shadow-2xl border-4" style="border-color: #f5f0e8;"><!-- Placeholder for photo - replace IMAGE_URL_HERE with actual photo -->
         <div id="hero-photo" class="w-full h-full flex items-center justify-center" style="background: linear-gradient(135deg, #d4c5b0 0%, #e8e0d5 50%, #f5f0e8 100%);">
          <div class="text-center p-8">
           <div class="w-32 h-32 mx-auto mb-4 rounded-full flex items-center justify-center" style="background: rgba(74, 93, 74, 0.1);">
            <svg class="w-16 h-16" fill="none" stroke="#4a5d4a" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
           </div>
           <p class="text-sm font-medium" style="color: #4a5d4a;">Foto Profil</p>
           <p class="text-xs mt-1" style="color: #8b7355;">IMAGE_URL_HERE</p>
          </div>
         </div>
        </div><!-- Floating decorative elements -->
        <div class="absolute -top-4 -right-4 w-24 h-24 rounded-2xl rotate-12 opacity-80" style="background: linear-gradient(135deg, #4a5d4a, #6b7b6b);"></div>
        <div class="absolute -bottom-6 -left-6 w-20 h-20 rounded-full" style="background: #d4c5b0;"></div>
       </div>
      </div>
     </div>
    </div>
   </section>
   <div class="section-divider max-w-4xl mx-auto"></div><!-- About Section -->
   <section id="about" class="py-24 px-6">
    <div class="max-w-7xl mx-auto">
     <div class="text-center mb-16">
      <p class="text-sm font-semibold tracking-[0.3em] uppercase mb-4" style="color: #4a5d4a;">Tentang</p>
      <h2 class="font-serif-elegant text-4xl md:text-5xl font-bold" style="color: #3d4d3d;">Tentang Saya</h2>
     </div>
     <div class="grid lg:grid-cols-2 gap-16"><!-- Main About Content -->
      <div class="space-y-6">
       <p class="text-lg leading-relaxed" style="color: #5a4a3a;">Saya adalah seorang <strong style="color: #4a5d4a;">lawyer</strong> lulusan <strong style="color: #4a5d4a;">Fakultas Hukum Universitas Diponegoro</strong>. Saat ini, saya bekerja sebagai <strong style="color: #4a5d4a;">Corporate Lawyer</strong> di perusahaan multinasional serta menjabat sebagai <strong style="color: #4a5d4a;">Penasihat Hukum di ANTM</strong> dengan fokus pada bidang keuangan.</p>
       <p class="text-lg leading-relaxed" style="color: #5a4a3a;">Selain itu, saya juga aktif sebagai <strong style="color: #4a5d4a;">freelancer translator</strong> dengan spesialisasi bahasa <strong style="color: #4a5d4a;">Mandarin, Spanyol, Jepang, dan Jerman</strong>.</p><!-- Interest Tags -->
       <div class="pt-6">
        <p class="text-sm font-semibold tracking-wide uppercase mb-4" style="color: #8b7355;">Minat &amp; Fokus</p>
        <div class="flex flex-wrap gap-3"><span class="px-6 py-3 rounded-full text-sm font-semibold text-white" style="background: linear-gradient(135deg, #4a5d4a, #5a6b5a);">⚖️ Hukum</span> <span class="px-6 py-3 rounded-full text-sm font-semibold" style="background: #d4c5b0; color: #3d4d3d;">🌍 Bahasa</span> <span class="px-6 py-3 rounded-full text-sm font-semibold border-2" style="border-color: #4a5d4a; color: #4a5d4a;">💼 Bisnis</span> <span class="px-6 py-3 rounded-full text-sm font-semibold" style="background: #f5f0e8; color: #5a4a3a;">📊 Keuangan</span>
        </div>
       </div>
      </div><!-- Values & Strengths -->
      <div class="space-y-6">
       <h3 class="font-serif-elegant text-2xl font-bold" style="color: #3d4d3d;">Nilai &amp; Keunggulan</h3>
       <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="card-hover p-6 rounded-2xl border" style="background: white; border-color: #e8e0d5;">
         <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: rgba(74, 93, 74, 0.1);"><span class="text-2xl">📚</span>
         </div>
         <h4 class="font-semibold mb-2" style="color: #3d4d3d;">Kemauan Belajar</h4>
         <p class="text-sm" style="color: #8b7355;">Selalu haus akan pengetahuan baru</p>
        </div>
        <div class="card-hover p-6 rounded-2xl border" style="background: white; border-color: #e8e0d5;">
         <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: rgba(74, 93, 74, 0.1);"><span class="text-2xl">🔄</span>
         </div>
         <h4 class="font-semibold mb-2" style="color: #3d4d3d;">Adaptif</h4>
         <p class="text-sm" style="color: #8b7355;">Fleksibel dalam berbagai situasi</p>
        </div>
        <div class="card-hover p-6 rounded-2xl border" style="background: white; border-color: #e8e0d5;">
         <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: rgba(74, 93, 74, 0.1);"><span class="text-2xl">💡</span>
         </div>
         <h4 class="font-semibold mb-2" style="color: #3d4d3d;">Problem Solver</h4>
         <p class="text-sm" style="color: #8b7355;">Solusi kreatif untuk masalah kompleks</p>
        </div>
        <div class="card-hover p-6 rounded-2xl border" style="background: white; border-color: #e8e0d5;">
         <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: rgba(74, 93, 74, 0.1);"><span class="text-2xl">��</span>
         </div>
         <h4 class="font-semibold mb-2" style="color: #3d4d3d;">Multilingual</h4>
         <p class="text-sm" style="color: #8b7355;">EN, 中文, 日本語, ES, DE</p>
        </div>
        <div class="card-hover p-6 rounded-2xl border sm:col-span-2" style="background: white; border-color: #e8e0d5;">
         <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: rgba(74, 93, 74, 0.1);"><span class="text-2xl">🧠</span>
         </div>
         <h4 class="font-semibold mb-2" style="color: #3d4d3d;">Critical Thinking</h4>
         <p class="text-sm" style="color: #8b7355;">Analisis mendalam dan pemikiran logis dalam pengambilan keputusan</p>
        </div>
       </div>
      </div>
     </div>
    </div>
   </section>
   <div class="section-divider max-w-4xl mx-auto"></div><!-- Education & Experience Timeline -->
   <section id="pendidikan" class="py-24 px-6" style="background: linear-gradient(180deg, transparent, rgba(74, 93, 74, 0.03), transparent);">
    <div class="max-w-7xl mx-auto">
     <div class="text-center mb-16">
      <p class="text-sm font-semibold tracking-[0.3em] uppercase mb-4" style="color: #4a5d4a;">Perjalanan</p>
      <h2 class="font-serif-elegant text-4xl md:text-5xl font-bold" style="color: #3d4d3d;">Pendidikan &amp; Pengalaman</h2>
     </div>
     <div class="relative max-w-4xl mx-auto"><!-- Timeline Line -->
      <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 timeline-line transform md:-translate-x-1/2"></div><!-- Timeline Items -->
      <div class="space-y-12"><!-- 2020 - SD -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #4a5d4a;"></div>
        <div class="ml-20 md:ml-0 md:w-1/2 md:pr-12 md:text-right"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2 text-white" style="background: #4a5d4a;">2020</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Sekolah Dasar</h3>
         <p style="color: #8b7355;">SDN Ekanugraha</p>
        </div>
       </div><!-- 2023 - SMP -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #d4c5b0;"></div>
        <div class="ml-20 md:ml-auto md:w-1/2 md:pl-12"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2" style="background: #d4c5b0; color: #3d4d3d;">2023</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Sekolah Menengah Pertama</h3>
         <p style="color: #8b7355;">SMPN 1 Sagalaherang</p>
        </div>
       </div><!-- 2026 - SMA -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #4a5d4a;"></div>
        <div class="ml-20 md:ml-0 md:w-1/2 md:pr-12 md:text-right"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2 text-white" style="background: #4a5d4a;">2026</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Sekolah Menengah Atas</h3>
         <p style="color: #8b7355;">SMAN 1 Subang</p>
        </div>
       </div><!-- 2027 - IISMA -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #d4c5b0;"></div>
        <div class="ml-20 md:ml-auto md:w-1/2 md:pl-12"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2" style="background: #d4c5b0; color: #3d4d3d;">2027</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Awardee Beasiswa IISMA</h3>
         <p style="color: #8b7355;">Indonesian International Student Mobility Awards</p>
        </div>
       </div><!-- 2028 - Translator -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #4a5d4a;"></div>
        <div class="ml-20 md:ml-0 md:w-1/2 md:pr-12 md:text-right"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2 text-white" style="background: #4a5d4a;">2028 - Sekarang</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Freelance Translator</h3>
         <p style="color: #8b7355;">Mandarin, Spanyol, Jepang, Jerman</p>
        </div>
       </div><!-- 2029 - Sarjana Hukum -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #d4c5b0;"></div>
        <div class="ml-20 md:ml-auto md:w-1/2 md:pl-12"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2" style="background: #d4c5b0; color: #3d4d3d;">2029</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Sarjana Hukum (SH)</h3>
         <p style="color: #8b7355;">Universitas Diponegoro</p>
        </div>
       </div><!-- 2030 - Pelatihan Finance -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #4a5d4a;"></div>
        <div class="ml-20 md:ml-0 md:w-1/2 md:pr-12 md:text-right"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2 text-white" style="background: #4a5d4a;">2030</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Pelatihan Finance</h3>
         <p style="color: #8b7355;">International Monetary Fund (IMF)</p>
        </div>
       </div><!-- 2031 - Corporate Lawyer -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #d4c5b0;"></div>
        <div class="ml-20 md:ml-auto md:w-1/2 md:pl-12"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2" style="background: #d4c5b0; color: #3d4d3d;">2031 - Sekarang</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Corporate Lawyer</h3>
         <p style="color: #8b7355;">Perusahaan Multinasional &amp; Penasihat Hukum ANTM</p>
        </div>
       </div><!-- 2033 - Program Kemanusiaan -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #4a5d4a;"></div>
        <div class="ml-20 md:ml-0 md:w-1/2 md:pr-12 md:text-right"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2 text-white" style="background: #4a5d4a;">2033</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Program Kemanusiaan</h3>
         <p style="color: #8b7355;">UNICEF</p>
        </div>
       </div><!-- 2033 - Magister -->
       <div class="relative flex items-center gap-8 md:gap-0">
        <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full border-4 transform -translate-x-1/2" style="background: white; border-color: #d4c5b0;"></div>
        <div class="ml-20 md:ml-auto md:w-1/2 md:pl-12"><span class="inline-block px-3 py-1 rounded-full text-xs font-bold mb-2" style="background: #d4c5b0; color: #3d4d3d;">2033</span>
         <h3 class="font-serif-elegant text-xl font-bold" style="color: #3d4d3d;">Master of Laws (LL.M.)</h3>
